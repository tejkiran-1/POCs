<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LocationTrackerApp.Views.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LocationTrackerApp.ViewModels"
             x:DataType="viewmodels:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1FA2FF">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1FA2FF" Offset="0.0" />
            <GradientStop Color="#12D8FA" Offset="0.5" />
            <GradientStop Color="#A6FFCB" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid RowDefinitions="Auto, *, Auto, Auto">
            
            <!-- Abstract Floating Elements -->
            <Ellipse Grid.Row="0" 
                     WidthRequest="100" 
                     HeightRequest="100"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,30,30,0"
                     Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                        <GradientStop Color="#E0F7FF" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Header -->
            <StackLayout Grid.Row="0" 
                         Margin="30,60,30,20"
                         Spacing="10">
                
                <Label Text="Create Account"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                
                <Label Text="Join Location Tracker"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center" />
            </StackLayout>

            <!-- Registration Form -->
            <Frame Grid.Row="1"
                   Margin="30,20"
                   BackgroundColor="White"
                   CornerRadius="25"
                   HasShadow="True"
                   Padding="30"
                   VerticalOptions="Center">
                
                <StackLayout Spacing="20">
                    
                    <!-- Full Name Entry -->
                    <Frame BackgroundColor="#F8F9FA"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="0">
                        <Entry Placeholder="Full Name"
                               Text="{Binding FullName}"
                               TextColor="#2C3E50"
                               PlaceholderColor="#95A5A6"
                               FontSize="16"
                               HeightRequest="50" />
                    </Frame>
                    
                    <!-- Email Entry -->
                    <Frame BackgroundColor="#F8F9FA"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="0">
                        <Entry Placeholder="Email address"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               TextColor="#2C3E50"
                               PlaceholderColor="#95A5A6"
                               FontSize="16"
                               HeightRequest="50" />
                    </Frame>
                    
                    <!-- Password Entry -->
                    <Frame BackgroundColor="#F8F9FA"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="0">
                        <Entry Placeholder="Password"
                               Text="{Binding Password}"
                               IsPassword="True"
                               TextColor="#2C3E50"
                               PlaceholderColor="#95A5A6"
                               FontSize="16"
                               HeightRequest="50" />
                    </Frame>
                    
                    <!-- Confirm Password Entry -->
                    <Frame BackgroundColor="#F8F9FA"
                           BorderColor="Transparent"
                           CornerRadius="15"
                           Padding="0">
                        <Entry Placeholder="Confirm Password"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               TextColor="#2C3E50"
                               PlaceholderColor="#95A5A6"
                               FontSize="16"
                               HeightRequest="50" />
                    </Frame>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#E74C3C"
                           FontSize="14"
                           IsVisible="{Binding HasErrors}"
                           HorizontalOptions="Center" />

                    <!-- Register Button -->
                    <Button Text="Create Account"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#27AE60"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="15"
                            HeightRequest="50"
                            IsEnabled="{Binding IsNotBusy}" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#27AE60"
                                       HorizontalOptions="Center" />
                    
                </StackLayout>
            </Frame>

            <!-- Login Link -->
            <StackLayout Grid.Row="2"
                         HorizontalOptions="Center"
                         Orientation="Horizontal"
                         Spacing="5"
                         Margin="0,20">
                
                <Label Text="Already have an account?"
                       TextColor="White"
                       FontSize="14" />
                
                <Label Text="Sign In"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

            <!-- Abstract Floating Elements -->
            <Ellipse Grid.Row="3" 
                     WidthRequest="60" 
                     HeightRequest="60"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="40,0,0,40"
                     Opacity="0.3">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                        <GradientStop Color="#E0F7FF" Offset="1.0" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

        </Grid>
    </ScrollView>
</ContentPage>
