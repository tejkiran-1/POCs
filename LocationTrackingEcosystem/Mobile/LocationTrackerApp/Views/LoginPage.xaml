<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="LocationTrackerApp.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LocationTrackerApp.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1FA2FF">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1FA2FF" Offset="0.0" />
            <GradientStop Color="#12D8FA" Offset="0.5" />
            <GradientStop Color="#A6FFCB" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*, Auto, *, Auto, *">
        
        <!-- Abstract Floating Elements -->
        <Ellipse Grid.Row="0" 
                 WidthRequest="120" 
                 HeightRequest="120"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 Margin="30,50,0,0"
                 Opacity="0.3">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#E0F7FF" Offset="1.0" />
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- App Logo/Title -->
        <StackLayout Grid.Row="1" 
                     HorizontalOptions="Center" 
                     VerticalOptions="Center"
                     Spacing="10">
            
            <Frame BackgroundColor="Transparent"
                   BorderColor="White"
                   CornerRadius="50"
                   WidthRequest="100"
                   HeightRequest="100"
                   HasShadow="True">
                <Label Text="📍"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            
            <Label Text="Location Tracker"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            
            <Label Text="Connect. Track. Share."
                   FontSize="16"
                   TextColor="White"
                   Opacity="0.8"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Login Form -->
        <Frame Grid.Row="2"
               Margin="30,20"
               BackgroundColor="White"
               CornerRadius="25"
               HasShadow="True"
               Padding="30"
               VerticalOptions="Center">
            
            <StackLayout Spacing="20">
                
                <!-- Email Entry -->
                <Frame BackgroundColor="#F8F9FA"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="0">
                    <Entry x:Name="EmailEntry"
                           Placeholder="Email address"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           TextColor="#2C3E50"
                           PlaceholderColor="#95A5A6"
                           FontSize="16"
                           HeightRequest="50" />
                </Frame>
                
                <!-- Password Entry -->
                <Frame BackgroundColor="#F8F9FA"
                       BorderColor="Transparent"
                       CornerRadius="15"
                       Padding="0">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           Text="{Binding Password}"
                           IsPassword="True"
                           TextColor="#2C3E50"
                           PlaceholderColor="#95A5A6"
                           FontSize="16"
                           HeightRequest="50" />
                </Frame>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#E74C3C"
                       FontSize="14"
                       IsVisible="{Binding HasErrors}"
                       HorizontalOptions="Center" />

                <!-- Login Button -->
                <Button Text="Sign In"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="15"
                        HeightRequest="50"
                        IsEnabled="{Binding IsNotBusy}" />

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#3498DB"
                                   HorizontalOptions="Center" />
                
            </StackLayout>
        </Frame>

        <!-- Register Link -->
        <StackLayout Grid.Row="3"
                     HorizontalOptions="Center"
                     Orientation="Horizontal"
                     Spacing="5">
            
            <Label Text="Don't have an account?"
                   TextColor="White"
                   FontSize="14" />
            
            <Label Text="Sign Up"
                   TextColor="White"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

        <!-- Abstract Floating Elements -->
        <Ellipse Grid.Row="4" 
                 WidthRequest="80" 
                 HeightRequest="80"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 Margin="0,0,40,30"
                 Opacity="0.2">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFF" Offset="0.0" />
                    <GradientStop Color="#E0F7FF" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

    </Grid>
</ContentPage>
